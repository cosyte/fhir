{
  "name": "@cosyte/fhir",
  "version": "0.1.9",
  "description": "FHIR R4 for Node.js and TypeScript: a resource model that keeps every value exactly as written, JSON and XML codecs, layered validation, and a safety readout for status and negation.",
  "keywords": [
    "fhir",
    "fhir-r4",
    "r4",
    "hl7",
    "healthcare",
    "interoperability",
    "typescript",
    "us-core",
    "validation",
    "json",
    "xml",
    "ndjson",
    "bundle",
    "fhirpath",
    "ucum"
  ],
  "homepage": "https://docs.cosyte.com/fhir",
  "bugs": {
    "url": "https://github.com/cosyte/fhir/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyte/fhir.git"
  },
  "license": "MIT",
  "author": "Cosyte <hello@cosyte.com> (https://cosyte.com)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.2": "0.28.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "minimatch@>=10.0.0 <11.0.1": "11.0.1"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./arbitraries": {
      "import": {
        "types": "./dist/arbitraries.d.ts",
        "default": "./dist/arbitraries.mjs"
      },
      "require": {
        "types": "./dist/arbitraries.d.cts",
        "default": "./dist/arbitraries.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "arbitraries": [
        "./dist/arbitraries.d.ts"
      ]
    }
  },
  "files": [
    "dist/index.mjs",
    "dist/index.cjs",
    "dist/index.d.ts",
    "dist/index.d.cts",
    "dist/arbitraries.mjs",
    "dist/arbitraries.cjs",
    "dist/arbitraries.d.ts",
    "dist/arbitraries.d.cts",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@cosyte/prettier-config",
  "scripts": {
    "build": "cosyte-process build",
    "changeset": "changeset",
    "typecheck": "cosyte-process typecheck",
    "lint": "cosyte-process lint",
    "lint:fix": "cosyte-process lint --fix",
    "format": "cosyte-process format",
    "format:check": "cosyte-process format --check",
    "test": "cosyte-process test",
    "test:watch": "cosyte-process test --watch",
    "test:coverage": "cosyte-process test --coverage",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "bench:reading": "cosyte-bench run --suite bench/fhir.bench.mjs --target dist/index.mjs",
    "bench:compare": "cosyte-bench compare --suite bench/fhir.bench.mjs",
    "clean": "rm -rf dist coverage",
    "pack:docs": "cosyte-process pack-docs",
    "attw": "cosyte-attw",
    "examples": "tsx scripts/run-examples.ts",
    "typecheck:examples": "tsc -p examples/tsconfig.json",
    "lint:examples": "node scripts/process-tool.mjs eslint examples --max-warnings=0",
    "phi-scan:examples": "tsx scripts/phi-scan.ts examples/*.ts",
    "phi-scan": "tsx scripts/phi-scan.ts",
    "corpus:fetch": "node scripts/corpus-fetch.mjs",
    "differential": "node scripts/differential.mjs",
    "differential:determinism": "node scripts/differential-determinism.mjs",
    "differential:read": "tsx scripts/read-differential.ts",
    "capture:base-readouts": "tsx scripts/capture-base-readouts.ts",
    "capture:xml-wellformed": "tsx scripts/capture-xml-wellformed.ts",
    "uscore:projection": "tsx scripts/uscore-projection.ts",
    "uscore:constraints": "tsx scripts/uscore-constraints.ts",
    "check:no-emdash": "cosyte-no-emdash",
    "check:no-internal-refs": "cosyte-internal-refs",
    "check:docs-set": "tsx scripts/docs-set-check.ts",
    "check:readme": "cosyte-readme",
    "check:claude-card": "cosyte-claude-card",
    "check:catalog": "cosyte-catalog",
    "check:process": "cosyte-process check",
    "version": "changeset version && cosyte-process sync-version && cosyte-process format",
    "release": "changeset publish",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm attw",
    "prepare": "command -v simple-git-hooks >/dev/null 2>&1 && simple-git-hooks 1>&2 || true"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm phi-scan --staged"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.0",
    "@cosyte/bench": "^0.1.1",
    "@cosyte/eslint-config": "^0.1.4",
    "@cosyte/prettier-config": "^0.1.2",
    "@cosyte/process": "^0.1.7",
    "@cosyte/script-utils": "^0.1.8",
    "@cosyte/test-utils": "^0.1.4",
    "@cosyte/tsconfig": "^0.1.2",
    "@cosyte/tsup-config": "^0.1.3",
    "@cosyte/vitest-config": "^0.1.3",
    "@types/node": "^22.0.0",
    "fast-check": "4.10.2",
    "simple-git-hooks": "2.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "fast-check": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "fast-check": {
      "optional": true
    }
  }
}
